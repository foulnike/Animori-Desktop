# Зависимости
node_modules/
.pnpm-store/

# Сборка
dist/
dist-tauri/
*.local

# Tauri (Этап 4). Здесь только target: дублирование дешёвое, а цена
# случайной фиксации собранных артефактов — гигабайты. Точные правила про
# схемы и разрешения — в src-tauri/.gitignore: широкое «src-tauri/permissions/»
# закрыло бы и будущие рукописные разрешения, а «src-tauri/gen/» — gen/android.
src-tauri/target/

# Логи
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Кэш инструментов
.vite/
.cache/
*.tsbuildinfo
vite.config.ts.timestamp-*.mjs

# Редакторы и ОС
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Секреты (токены подписи обновлений Tauri и пр.)
.env
.env.*
!.env.example
*.key
