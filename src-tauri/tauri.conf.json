{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AniMori",
  "version": "../package.json",
  "identifier": "com.foulnike.animori",
  "build": {
    "frontendDist": "../dist/app",
    "beforeBuildCommand": "npm run build:app",
    "beforeDevCommand": {
      "script": "npm run build:app",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/foulnike/Animori-Desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3RjNFQ0Y2Mzk1RDQzREYKUldUZlExMDU5dXp6eDJ1cmZ6Z001MTRYVzBPOFZ1T2sxRlczaVBJcmNBZzd6eURmRzhSTm0xQ2cK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
